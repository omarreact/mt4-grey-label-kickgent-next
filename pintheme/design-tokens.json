{
  "schemaVersion": "1.0",
  "site": "greylabel-technology",
  "source": "Tailwind CSS + CSS variable bridge",
  "colors": {
    "primary": "#9448f7",
    "secondary": "#24102f",
    "accent": "#d69aff",
    "background": "#100414",
    "foreground": "#fcf8ff",
    "surface": "#24102f",
    "muted": "#c7b6d0"
  },
  "typography": {
    "heading": "Inter, system-ui, sans-serif",
    "body": "Inter, system-ui, sans-serif"
  },
  "spacing": {
    "section": "72px",
    "containerPadding": "24px",
    "mobile": "16px"
  },
  "layout": {
    "container": "1180px",
    "headerHeight": "76px"
  },
  "radius": {
    "card": "17px",
    "button": "11px"
  },
  "shadows": {
    "card": "0 15px 50px rgba(19,5,31,.25)"
  },
  "cssVariables": [
    "--pt-primary",
    "--pt-secondary",
    "--pt-accent",
    "--pt-bg",
    "--pt-surface",
    "--pt-text",
    "--pt-muted",
    "--pt-container",
    "--pt-section",
    "--pt-card-radius",
    "--pt-button-radius",
    "--pt-logo-width",
    "--pt-logo-height",
    "--pt-header-height"
  ]
}
